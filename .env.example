# Model provider: "groq" (the free tier works) or "anthropic"
WORKER_PROVIDER=groq

# Groq - https://console.groq.com/keys
GROQ_API_KEY=
# Groq defaults: worker openai/gpt-oss-120b, verifier openai/gpt-oss-20b, effort medium;
# each model falls back to the other if its daily quota runs out.
# WORKER_MODEL=openai/gpt-oss-120b
# WORKER_VERIFIER_MODEL=openai/gpt-oss-20b

# Anthropic - https://console.anthropic.com/settings/keys (set WORKER_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# Anthropic defaults: claude-opus-5 for worker and verifier, effort high.
# WORKER_REFUSAL_FALLBACK=1

# Optional overrides
# WORKER_EFFORT=medium
# WORKER_FALLBACK_MODELS=openai/gpt-oss-20b

# Test credentials for the simulated Northwind ERP (mock_env/data.py).
# The worker references these as {{secret:NAME}}; the model never sees the values.
WORKER_SECRET_ERP_PASSWORD=nw-demo-2026
WORKER_SECRET_ERP_API_KEY=nw-test-api-key-7f3a
